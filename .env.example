# Copy to .env.local for local development
# Backend API (bunun_backend)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Shared with the admin panel; lets it refresh the storefront's catalogue cache (POST /api/revalidate)
REVALIDATE_SECRET=

# Error tracking (Sentry, free plan): sentry.io -> project -> Client Keys (DSN). Off when empty.
NEXT_PUBLIC_SENTRY_DSN=
# e.g. staging or production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
